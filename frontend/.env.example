# Compass frontend - environment configuration.
# Copy to .env.local for local dev (never commit .env.local - see root .gitignore).

# --- Evidence mode and local identity --------------------------------------
# Live public evidence is always the runtime default. Rehearsal is selected
# explicitly in the application shell or at /rehearsal/ and is persisted in
# this browser.
# AUTH_DISABLED=true skips the Cognito Hosted UI redirect and synthesizes a
# local persona. Keep authentication enabled for a deployed environment.
NEXT_PUBLIC_AUTH_DISABLED=true

# --- Backend API (HttpApi custom domain or execute-api invoke URL) ---------
# e.g. https://api.compass-demo.example.com or the API Gateway invoke URL for
# the deployed stage. A missing live service remains unavailable. Compass never
# substitutes synthetic records unless rehearsal was explicitly selected.
NEXT_PUBLIC_API_BASE_URL=

# --- Cognito (ignored while NEXT_PUBLIC_AUTH_DISABLED=true) ----------------
# User pool issuer, e.g. https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_AUTHORITY=
# Hosted UI domain, e.g. https://compass-demo.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/login/
NEXT_PUBLIC_COGNITO_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login/

# --- Single-mode presentation (viewers see one live mode) ------------------
# NEXT_PUBLIC_SINGLE_MODE=true hides the rehearsal UI entirely: no mode
# toggle, no /rehearsal navigation, /rehearsal/* redirects to the live pages.
# Pass it INLINE for one-off builds only, e.g.
#   NEXT_PUBLIC_SINGLE_MODE=true pnpm build
# Never persist it in .env.local - `pnpm test:e2e` builds from this directory
# and the suite requires the flag off.
# NEXT_PUBLIC_SINGLE_MODE=true
