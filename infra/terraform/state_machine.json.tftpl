{
  "Comment": "Compass document pipeline",
  "StartAt": "Inspect",
  "States": {
    "Inspect": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {"action": "inspect", "event.$": "$"}
      },
      "Retry": [{
        "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
        "IntervalSeconds": 2,
        "MaxAttempts": 3,
        "BackoffRate": 2
      }],
      "Next": "InspectionGate"
    },
    "InspectionGate": {
      "Type": "Choice",
      "Choices": [
        {"Variable": "$.gate", "StringEquals": "quarantine", "Next": "Quarantine"},
        {"Variable": "$.gate", "StringEquals": "continue", "Next": "Quality"}
      ],
      "Default": "Failed"
    },
    "Quality": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "quality",
          "run_id.$": "$.run_id",
          "source_bucket.$": "$.source_bucket",
          "source_key.$": "$.source_key",
          "bronze_key.$": "$.bronze_key",
          "org_unit.$": "$.org_unit"
        }
      },
      "Next": "QualityGate"
    },
    "QualityGate": {
      "Type": "Choice",
      "Choices": [
        {"Variable": "$.gate", "StringEquals": "pass", "Next": "Curate"},
        {"Variable": "$.gate", "StringEquals": "quarantine", "Next": "Quarantine"}
      ],
      "Default": "Failed"
    },
    "Curate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "curate",
          "run_id.$": "$.run_id",
          "source_bucket.$": "$.source_bucket",
          "source_key.$": "$.source_key",
          "bronze_key.$": "$.bronze_key",
          "quality_key.$": "$.quality_key",
          "org_unit.$": "$.org_unit"
        }
      },
      "End": true
    },
    "Quarantine": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_arn}",
        "Payload": {
          "action": "quarantine",
          "run_id.$": "$.run_id",
          "source_bucket.$": "$.source_bucket",
          "source_key.$": "$.source_key",
          "reason.$": "$.reason"
        }
      },
      "End": true
    },
    "Failed": {
      "Type": "Fail",
      "Error": "CompassDocumentPipelineFailed"
    }
  }
}
