version = 0.1

# =============================================================================
# Compass demo - SAM deploy config.
#
# Rename to `samconfig.toml` before deploying. Region is PINNED to us-east-1:
# the WAF WebACL is Scope CLOUDFRONT, which only exists there.
#
# Two-deploy dance (Cognito callback URLs need the CloudFront domain, which
# does not exist until the first deploy):
#   1. `sam build && sam deploy` with the empty Web* overrides below.
#   2. Read the CloudFrontDomain stack output, fill WebCallbackUrl /
#      WebLogoutUrl / WebOrigin, and deploy again.
#
# NOTE: parameter_overrides is a TOML ARRAY - one "Key=Value" string per
# element. Do not put whitespace inside a value; SAM CLI re-splits on spaces.
#
# BUILD NOTE: the CommonLayer pip-installs psycopg2-binary for Lambda
# (linux/arm64). On macOS, build with `sam build --use-container` so the layer
# gets manylinux aarch64 wheels instead of darwin ones.
# =============================================================================

# -----------------------------------------------------------------------------
# Default - the single demo stack `compass-demo`.
# -----------------------------------------------------------------------------
[default]
[default.global.parameters]
stack_name = "compass-demo"

[default.build.parameters]
cached = true
parallel = true

[default.validate.parameters]
lint = true

[default.deploy.parameters]
region = "us-east-1"
resolve_s3 = true
capabilities = "CAPABILITY_IAM CAPABILITY_NAMED_IAM"
confirm_changeset = true
parameter_overrides = [
  "WebCallbackUrl=",
  "WebLogoutUrl=",
  "WebOrigin=",
  "CognitoDomainPrefix=",
  "MfaMode=required",
  "ExportMaxRows=5000",
  "WafRateLimit=2000",
  "StreamTickerState=ENABLED",
  "DeploySecurityBaseline=false",
  "DeployRevision=local",
  "DatabaseResilienceMode=demo",
  "ScaleFeatureEnabled=false",
  "ScaleMaxRecords=100000",
  "ScaleMaxConcurrency=4",
  "ScaleExportConcurrency=2",
  "ScaleMaxEstimatedCostUsd=10",
  "ScaleDataRetentionDays=7",
  "ScaleEvidenceRetentionDays=30",
  "ScaleAthenaBytesScannedCutoff=10737418240",
]

# -----------------------------------------------------------------------------
# Dev - an isolated second stack (`sam deploy --config-env dev`) for trying
# template changes without touching the demo stack. Ticker off, baseline off.
# Bucket names and the default Cognito domain prefix derive from the stack
# name, so the two stacks coexist without overrides.
# -----------------------------------------------------------------------------
[dev]
[dev.global.parameters]
stack_name = "compass-demo-dev"

[dev.build.parameters]
cached = true
parallel = true

[dev.validate.parameters]
lint = true

[dev.deploy.parameters]
region = "us-east-1"
resolve_s3 = true
capabilities = "CAPABILITY_IAM CAPABILITY_NAMED_IAM"
confirm_changeset = true
parameter_overrides = [
  "WebCallbackUrl=",
  "WebLogoutUrl=",
  "WebOrigin=",
  "CognitoDomainPrefix=",
  "MfaMode=required",
  "ExportMaxRows=5000",
  "WafRateLimit=2000",
  "StreamTickerState=DISABLED",
  "DeploySecurityBaseline=false",
  "DeployRevision=local",
  "DatabaseResilienceMode=demo",
  "ScaleFeatureEnabled=false",
  "ScaleMaxRecords=100000",
  "ScaleMaxConcurrency=4",
  "ScaleExportConcurrency=2",
  "ScaleMaxEstimatedCostUsd=10",
  "ScaleDataRetentionDays=7",
  "ScaleEvidenceRetentionDays=30",
  "ScaleAthenaBytesScannedCutoff=10737418240",
]
